# App Settings
PROJECT_NAME="GoalForge AI"
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secret-key-for-jwt-development-only"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# Database Settings
# Use Supabase/Neon connection string (Direct connection, not pooling for Alembic)
DATABASE_URL="postgresql+asyncpg://user:password@host:port/dbname"

# Redis Settings
# Use Redis Cloud connection string
REDIS_URL="redis://:password@host:port/0"

# Environment
ENVIRONMENT="development" # development, staging, production
DEBUG=True
LOG_LEVEL="info"
